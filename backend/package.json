{
  "name": "event-analytics-backend",
  "version": "0.1.0",
  "description": "Express + MongoDB API for the event analytics assignment",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prestart": "npm run build",
    "test": "TZ=UTC MONGO_URL=mongodb://localhost:27017/event_analytics_test PORT=0 UPLOAD_DIR=/tmp/event-analytics-test-uploads node --import tsx --test --test-concurrency=1 --test-force-exit --test-reporter=spec test/*.test.ts"
  },
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.3.0",
    "joi": "^18.3.1",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "stream-json": "^1.9.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/stream-json": "^1.7.8",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
